// COMPANY CATEGORY - Company Management

model Company {
  id       String  @id @default(cuid())
  tenantId String? // Multi-tenancy support
  name     String
  email    String  @unique
  phone    String?
  website  String?
  logoUrl  String?

  // Company details
  description String? @db.Text
  address     String? @db.Text
  country     String?
  state       String?
  city        String?
  industry    String?
  companySize String?
  workModel   String?
  gstin       String?
  linkedInUrl String?

  // ERP Enhancements
  metadata Json? // Custom fields and extensible data
  version  Int   @default(1) // Optimistic locking

  // Status
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  tenant       Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  creator      User?         @relation("CompanyCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?         @relation("CompanyUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  companyUsers CompanyUser[]
  companyRoles CompanyRole[]
  jobs         Job[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, isActive, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("companies")
}

model CompanyUser {
  id        String @id @default(cuid())
  userId    String
  companyId String
  roleId    String

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  user    User        @relation(fields: [userId], references: [id])
  company Company     @relation(fields: [companyId], references: [id])
  role    CompanyRole @relation(fields: [roleId], references: [id])
  creator User?       @relation("CompanyUserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User?       @relation("CompanyUserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([userId, companyId])
  @@index([companyId, isActive, deletedAt])
  @@index([roleId])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("company_users")
}

model CompanyRole {
  id          String  @id @default(cuid())
  companyId   String
  name        String
  description String? @db.Text

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  company     Company                 @relation(fields: [companyId], references: [id])
  users       CompanyUser[]
  permissions CompanyRolePermission[]
  creator     User?                   @relation("CompanyRoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater     User?                   @relation("CompanyRoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@index([companyId, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("company_roles")
}

model CompanyPermission {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?         @db.Text
  scope       PermissionScope @default(COMPANY)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  companyRolePermissions CompanyRolePermission[]

  @@map("company_permissions")
}

model CompanyRolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Timestamps
  createdAt DateTime @default(now())

  // Relationships
  role       CompanyRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission CompanyPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("company_role_permissions")
}

