// VENDOR CATEGORY - Vendor Management

model Vendor {
  id       String  @id @default(cuid())
  tenantId String? // Multi-tenancy support
  name     String
  email    String  @unique
  phone    String?
  website  String?
  logoUrl  String?

  // Vendor details
  description String? @db.Text
  address     String? @db.Text
  country     String?
  state       String?
  city        String?
  industry    String?
  vendorSize  String?
  workModel   String?
  gstin       String?
  linkedInUrl String?

  // ERP Enhancements
  metadata Json? // Custom fields and extensible data
  version  Int   @default(1) // Optimistic locking

  // Status
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  creator     User?        @relation("VendorCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater     User?        @relation("VendorUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  vendorUsers VendorUser[]
  vendorRoles VendorRole[]

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, isActive, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("vendors")
}

model VendorUser {
  id       String @id @default(cuid())
  userId   String
  vendorId String
  roleId   String

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Status
  isActive Boolean @default(true)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  user    User       @relation(fields: [userId], references: [id])
  vendor  Vendor     @relation(fields: [vendorId], references: [id])
  role    VendorRole @relation(fields: [roleId], references: [id])
  creator User?      @relation("VendorUserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User?      @relation("VendorUserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([userId, vendorId])
  @@index([userId, vendorId])
  @@index([vendorId, isActive, deletedAt])
  @@index([roleId])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("vendor_users")
}

model VendorRole {
  id          String  @id @default(cuid())
  vendorId    String
  name        String
  description String? @db.Text

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  vendor      Vendor                 @relation(fields: [vendorId], references: [id])
  users       VendorUser[]
  permissions VendorRolePermission[]
  creator     User?                  @relation("VendorRoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater     User?                  @relation("VendorRoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@unique([vendorId, name])
  @@index([vendorId, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("vendor_roles")
}

model VendorPermission {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?         @db.Text
  scope       PermissionScope @default(VENDOR)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  vendorRolePermissions VendorRolePermission[]

  @@map("vendor_permissions")
}

model VendorRolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Timestamps
  createdAt DateTime @default(now())

  // Relationships
  role       VendorRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission VendorPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("vendor_role_permissions")
}

