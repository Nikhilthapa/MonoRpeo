// Job Marketplace Database Schema
// Domain: Job Marketplace
// Database: job_db

generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/backend/database/src/clients/generated/job"
}

datasource db {
  provider = "postgresql"
  url      = env("JOB_DATABASE_URL")
}

// Shared Enums
enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  PAUSED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW_SCHEDULED
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ============================================================================
// JOB MODELS
// ============================================================================
model Job {
  id        String  @id @default(cuid())
  tenantId  String? // Reference to Tenant.id in tenant_db
  companyId String  // Reference to Company.id in organization_db

  // Basic Info
  title       String
  description String? @db.Text
  jobOverview String? @db.Text

  // Employment Details
  employmentType   String?
  workModel        String?
  location         String?
  country          String?
  state            String?
  city             String?
  numberOfOpenings Int     @default(1)

  // Experience & Qualification
  experienceLevel      String?
  minExperience        Int?
  maxExperience        Int?
  educationRequirement String?

  // Compensation
  minSalary    Decimal? @db.Decimal(10, 2)
  maxSalary    Decimal? @db.Decimal(10, 2)
  currency     String?
  paymentType  String?
  noticePeriod String?

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Status
  status JobStatus @default(DRAFT)

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  closedAt    DateTime?
  deletedAt   DateTime?
  archivedAt  DateTime?

  // Audit Fields (references to User.id in identity_db)
  createdBy String? // Reference to User.id
  updatedBy String? // Reference to User.id

  // Denormalized company data for quick access
  companyName String? // Denormalized from Company.name
  companyEmail String? // Denormalized from Company.email

  // Relationships (within job database)
  applications   JobApplication[]
  savedByUsers   SavedJob[]
  requiredSkills JobSkill[]

  @@index([tenantId, companyId, status])
  @@index([tenantId, status, deletedAt])
  @@index([companyId, status])
  @@index([status, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([createdAt])
  @@map("jobs")
}

model JobApplication {
  id     String @id @default(cuid())
  jobId  String
  userId String // Reference to User.id in identity_db

  // Application Details
  coverLetter String?           @db.Text
  status      ApplicationStatus @default(PENDING)

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String? // Reference to User.id
  updatedBy String? // Reference to User.id

  // Denormalized user data for quick access
  userEmail String? // Denormalized from User.email
  userName  String? // Denormalized from User.firstName + lastName

  // Relationships (within job database)
  job Job @relation(fields: [jobId], references: [id])

  @@unique([jobId, userId])
  @@index([jobId, userId])
  @@index([userId, status])
  @@index([jobId, status])
  @@index([status, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("job_applications")
}

model SavedJob {
  id     String @id @default(cuid())
  jobId  String
  userId String // Reference to User.id in identity_db

  // Timestamps
  createdAt DateTime @default(now())

  // Relationships
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([userId])
  @@index([jobId])
  @@map("saved_jobs")
}

model JobSkill {
  id         String  @id @default(cuid())
  jobId      String
  skillId    String  // Reference to Skill.id in identity_db
  isRequired Boolean @default(true)

  // Denormalized skill data
  skillName String? // Denormalized from Skill.name

  // Timestamps
  createdAt DateTime @default(now())

  // Relationships
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, skillId])
  @@index([jobId])
  @@index([skillId])
  @@map("job_skills")
}
