// Workflow Database Schema
// Domain: Process Management
// Database: workflow_db

generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/backend/database/src/clients/generated/workflow"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// Shared Enums
enum WorkflowStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  CANCELLED
}

// ============================================================================
// WORKFLOW MODELS
// ============================================================================
model Workflow {
  id          String  @id @default(cuid())
  tenantId    String? // Reference to Tenant.id in tenant_db
  name        String
  description String? @db.Text
  entityType  String

  // Workflow Configuration
  isActive  Boolean @default(true)
  isDefault Boolean @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships (within workflow database)
  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@unique([tenantId, entityType, name])
  @@index([tenantId, entityType, isActive])
  @@index([deletedAt])
  @@map("workflows")
}

model WorkflowStep {
  id          String  @id @default(cuid())
  workflowId  String
  stepOrder   Int
  name        String
  description String? @db.Text

  // Step Configuration
  approverRoleId String?
  isRequired     Boolean @default(true)
  canSkip        Boolean @default(false)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  workflow          Workflow           @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowInstances WorkflowInstance[]

  @@unique([workflowId, stepOrder])
  @@index([workflowId])
  @@map("workflow_steps")
}

model WorkflowInstance {
  id         String @id @default(cuid())
  workflowId String
  entityType String
  entityId   String

  // Current State
  currentStepId String?
  status        WorkflowStatus @default(PENDING)

  // Tracking (references to User.id in identity_db)
  startedBy   String? // Reference to User.id
  completedBy String? // Reference to User.id
  startedByEmail String? // Denormalized from User.email
  completedByEmail String? // Denormalized from User.email
  completedAt DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships (within workflow database)
  workflow    Workflow      @relation(fields: [workflowId], references: [id])
  currentStep WorkflowStep? @relation(fields: [currentStepId], references: [id], onDelete: SetNull)

  @@unique([entityType, entityId])
  @@index([workflowId, status])
  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@map("workflow_instances")
}
