// Identity & Access Management Database Schema
// Domain: Identity & Access Management
// Database: identity_db

generator client {
  provider = "prisma-client-js"
  output   = "../../../libs/backend/database/src/clients/generated/identity"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// Shared Enums
enum PermissionScope {
  SYSTEM
  COMPANY
  VENDOR
}

enum ProfileStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

// ============================================================================
// USER MODEL
// ============================================================================
model User {
  id        String  @id @default(cuid())
  tenantId  String? // Reference to Tenant.id in tenant_db
  email     String  @unique
  password  String?
  firstName String?
  lastName  String?
  phone     String?
  avatarUrl String?

  // Profile fields
  shortDescription     String?  @db.Text
  profileSummary       String?  @db.Text
  currentJobFunction   String?
  linkedInProfile      String?
  yearsOfExperience    String?
  preferredLocation    String?
  noticePeriod         String?
  preferredWorkModel   String?
  currentAnnualSalary  Decimal? @db.Decimal(10, 2)
  expectedAnnualSalary Decimal? @db.Decimal(10, 2)

  // ERP Enhancements
  metadata Json?
  version  Int   @default(1)

  // Status
  emailVerified Boolean      @default(false)
  isActive      Boolean      @default(true)
  profileStatus ProfileStatus @default(PENDING_REVIEW)

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields (self-references within same database)
  createdBy String?
  updatedBy String?

  // Self-referential relationships (within same database)
  creator      User?  @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater      User?  @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  // Relationships within identity database
  systemRole   SystemRole? @relation("UserSystemRole", fields: [systemRoleId], references: [id])
  systemRoleId String?     @unique

  userSkills UserSkill[]
  experiences Experience[]
  educations Education[]
  resumes Resume[]

  // Audit relationships - Created/Updated by this user (within same database)
  createdSystemRoles SystemRole[] @relation("SystemRoleCreatedBy")
  updatedSystemRoles SystemRole[] @relation("SystemRoleUpdatedBy")

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId, isActive, deletedAt])
  @@index([deletedAt])
  @@index([archivedAt])
  @@map("users")
}

// ============================================================================
// SYSTEM ROLE & PERMISSIONS
// ============================================================================
model SystemRole {
  id          String  @id @default(cuid())
  name        String  @unique
  description String? @db.Text

  // ERP Enhancements
  version  Int   @default(1)
  metadata Json?

  // Timestamps
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime?

  // Audit Fields
  createdBy String?
  updatedBy String?

  // Relationships
  users       User[]                 @relation("UserSystemRole")
  permissions SystemRolePermission[]

  creator User? @relation("SystemRoleCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater User? @relation("SystemRoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([deletedAt])
  @@index([archivedAt])
  @@map("system_roles")
}

model SystemPermission {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?         @db.Text
  scope       PermissionScope @default(SYSTEM)

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  systemRolePermissions SystemRolePermission[]

  @@map("system_permissions")
}

model SystemRolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  // Timestamps
  createdAt DateTime @default(now())

  // Relationships
  role       SystemRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission SystemPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("system_role_permissions")
}

// ============================================================================
// SKILLS CATALOG
// ============================================================================
model Skill {
  id          String  @id @default(cuid())
  name        String  @unique
  category    String?
  description String? @db.Text

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships (within same database)
  userSkills UserSkill[]

  @@index([name])
  @@map("skills")
}

model UserSkill {
  id          String  @id @default(cuid())
  userId      String
  skillId     String
  proficiency String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

// ============================================================================
// USER PROFILE DATA
// ============================================================================
model Experience {
  id     String @id @default(cuid())
  userId String

  // Experience Details
  title          String
  company        String
  employmentType String?
  location       String?
  description    String? @db.Text

  // Dates
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean   @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("experiences")
}

model Education {
  id     String @id @default(cuid())
  userId String

  // Education Details
  degree       String
  institution  String
  fieldOfStudy String?
  location     String?
  description  String? @db.Text

  // Dates & Grades
  startDate   DateTime?
  endDate     DateTime?
  grade       String?
  isCompleted Boolean   @default(false)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("educations")
}

model Resume {
  id     String @id @default(cuid())
  userId String

  // File Details
  fileName  String
  fileUrl   String
  fileSize  Int?
  mimeType  String?
  isPrimary Boolean @default(false)

  // Timestamps
  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("resumes")
}
