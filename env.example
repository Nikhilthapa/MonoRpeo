# ==============================================================================
# Hirenova Workspace - Environment Variables
# ==============================================================================
# Copy this file to .env.docker and update with your actual values
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Database Credentials
DB_USER=postgres
DB_PASSWORD=prisma

# Database Names
IDENTITY_DB_NAME=identity_db
TENANT_DB_NAME=tenant_db
ORGANIZATION_DB_NAME=organization_db
JOB_DB_NAME=job_db
AUDIT_DB_NAME=audit_db
WORKFLOW_DB_NAME=workflow_db

# Database Ports (PostgreSQL)
POSTGRES_IDENTITY_PORT=5433
POSTGRES_TENANT_PORT=5434
POSTGRES_ORGANIZATION_PORT=5435
POSTGRES_JOB_PORT=5436
POSTGRES_AUDIT_PORT=5437
POSTGRES_WORKFLOW_PORT=5438

# PgBouncer Ports (Connection Pooling)
PGBOUNCER_IDENTITY_PORT=6433
PGBOUNCER_TENANT_PORT=6434
PGBOUNCER_ORGANIZATION_PORT=6435
PGBOUNCER_JOB_PORT=6436
PGBOUNCER_AUDIT_PORT=6437
PGBOUNCER_WORKFLOW_PORT=6438

# Database URLs (Domain-Based)
# Identity Database - Identity & Access Management
IDENTITY_DATABASE_URL=postgresql://postgres:prisma@postgres-identity:5432/identity_db?schema=public

# Tenant Database - Multi-Tenancy & Configuration
TENANT_DATABASE_URL=postgresql://postgres:prisma@postgres-tenant:5432/tenant_db?schema=public

# Organization Database - Organizational Structure
ORGANIZATION_DATABASE_URL=postgresql://postgres:prisma@postgres-organization:5432/organization_db?schema=public

# Job Database - Job Marketplace
JOB_DATABASE_URL=postgresql://postgres:prisma@postgres-job:5432/job_db?schema=public

# Audit Database - Audit & Compliance
AUDIT_DATABASE_URL=postgresql://postgres:prisma@postgres-audit:5432/audit_db?schema=public

# Workflow Database - Process Management
WORKFLOW_DATABASE_URL=postgresql://postgres:prisma@postgres-workflow:5432/workflow_db?schema=public

# Legacy Database URL (for backward compatibility, points to identity_db)
DATABASE_URL=postgresql://postgres:prisma@postgres-identity:5432/identity_db?schema=public

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

# Redis Password
REDIS_PASSWORD=redis123

# Redis Ports
REDIS_PORT=6379
REDIS_CONTACT_LOOKUP_PORT=6381
REDIS_DATA_SCRAPER_PORT=6382

# Redis URLs
REDIS_URL=redis://:redis123@redis:6379
REDIS_CONTACT_LOOKUP_URL=redis://:redis123@redis-contact-lookup:6379
REDIS_DATA_SCRAPER_URL=redis://:redis123@redis-data-scraper:6379

# ==============================================================================
# RABBITMQ CONFIGURATION
# ==============================================================================

# RabbitMQ Credentials
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123

# RabbitMQ Ports
RABBITMQ_SERVICE_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# RabbitMQ URL
RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672

# ==============================================================================
# SERVICE PORTS
# ==============================================================================

# API Gateway
API_GATEWAY_PORT=3031
API_GATEWAY_INTERNAL_PORT=3031

# Backend Services
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_INTERNAL_PORT=3001

COMPANY_SERVICE_PORT=3002
COMPANY_SERVICE_INTERNAL_PORT=3002

JOB_SERVICE_PORT=3003
JOB_SERVICE_INTERNAL_PORT=3003

TENANT_SERVICE_PORT=3004
TENANT_SERVICE_INTERNAL_PORT=3004

AUDIT_SERVICE_PORT=3005
AUDIT_SERVICE_INTERNAL_PORT=3005

NOTIFICATION_SERVICE_PORT=3006
NOTIFICATION_SERVICE_INTERNAL_PORT=3006

SEARCH_SERVICE_PORT=3007
SEARCH_SERVICE_INTERNAL_PORT=3007

# Microservices
JOB_PROCESSOR_PORT=4001
JOB_PROCESSOR_INTERNAL_PORT=4001

DATA_SCRAPER_PORT=4002
DATA_SCRAPER_INTERNAL_PORT=4002

RESEARCHER_WORKER_PORT=4003
RESEARCHER_WORKER_INTERNAL_PORT=4003

SCRAPER_PORT=4004
SCRAPER_INTERNAL_PORT=4004

CONTACT_LOOKUP_PORT=4005
CONTACT_LOOKUP_INTERNAL_PORT=4005

EMAIL_VERIFICATION_WORKER_PORT=4006
EMAIL_VERIFICATION_WORKER_INTERNAL_PORT=4006

BULK_EMAIL_SERVICE_PORT=3045
BULK_EMAIL_SERVICE_INTERNAL_PORT=3045

# ==============================================================================
# QUEUE CONFIGURATION
# ==============================================================================

# Email Scraper Queues
EMAIL_SCRAPER_INPUT_QUEUE=email_scraper_input
EMAIL_SCRAPER_SUCCESS_QUEUE=email_scraper_success
EMAIL_SCRAPER_ERROR_QUEUE=email_scraper_error
EMAIL_SCRAPER_PROGRESS_QUEUE=email_scraper_progress

# ==============================================================================
# AWS CONFIGURATION (for SES/Email Services)
# ==============================================================================

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ==============================================================================
# SHARED STORAGE (NFS)
# ==============================================================================

# NFS Manager IP (required for NFS setup)
# NFS_MANAGER_IP=192.168.1.100

# Shared Storage Path
# SHARED_STORAGE_PATH=/mnt/shared

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

NODE_ENV=production

# ==============================================================================
# NOTES
# ==============================================================================
# 1. Copy this file to .env.docker: cp env.example .env.docker
# 2. Update all passwords in production
# 3. Set NFS_MANAGER_IP if using NFS shared storage
# 4. Update AWS credentials if using SES
# 5. Database URLs use Docker service names for internal communication
# 6. For local development, replace service names with localhost and update ports
