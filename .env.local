# ==============================================================================
# Hirenova Workspace - Environment Variables (Local Development)
# ==============================================================================
# This file is for local development. For Docker, use .env.docker
# ==============================================================================

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================

# Database Credentials
DB_USER=postgres
DB_PASSWORD=prisma

# Database Names
IDENTITY_DB_NAME=identity_db
TENANT_DB_NAME=tenant_db
ORGANIZATION_DB_NAME=organization_db
JOB_DB_NAME=job_db
AUDIT_DB_NAME=audit_db
WORKFLOW_DB_NAME=workflow_db

# Database Ports (PostgreSQL) - Local Development
POSTGRES_IDENTITY_PORT=5433
POSTGRES_TENANT_PORT=5434
POSTGRES_ORGANIZATION_PORT=5435
POSTGRES_JOB_PORT=5436
POSTGRES_AUDIT_PORT=5437
POSTGRES_WORKFLOW_PORT=5438

# Database URLs (Local Development - using localhost)
IDENTITY_DATABASE_URL=postgresql://postgres:prisma@localhost:5433/identity_db?schema=public
TENANT_DATABASE_URL=postgresql://postgres:prisma@localhost:5434/tenant_db?schema=public
ORGANIZATION_DATABASE_URL=postgresql://postgres:prisma@localhost:5435/organization_db?schema=public
JOB_DATABASE_URL=postgresql://postgres:prisma@localhost:5436/job_db?schema=public
AUDIT_DATABASE_URL=postgresql://postgres:prisma@localhost:5437/audit_db?schema=public
WORKFLOW_DATABASE_URL=postgresql://postgres:prisma@localhost:5438/workflow_db?schema=public

# Legacy Database URL (for backward compatibility)
DATABASE_URL=postgresql://postgres:prisma@localhost:5433/identity_db?schema=public

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================

REDIS_PASSWORD=redis123
REDIS_PORT=6379
REDIS_URL=redis://:redis123@localhost:6379

# ==============================================================================
# RABBITMQ CONFIGURATION
# ==============================================================================

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin123
RABBITMQ_SERVICE_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://admin:admin123@localhost:5672

# ==============================================================================
# SERVICE PORTS
# ==============================================================================

API_GATEWAY_PORT=3031
API_GATEWAY_INTERNAL_PORT=3031

AUTH_SERVICE_PORT=3001
AUTH_SERVICE_INTERNAL_PORT=3001

COMPANY_SERVICE_PORT=3002
COMPANY_SERVICE_INTERNAL_PORT=3002

JOB_SERVICE_PORT=3003
JOB_SERVICE_INTERNAL_PORT=3003

TENANT_SERVICE_PORT=3004
TENANT_SERVICE_INTERNAL_PORT=3004

AUDIT_SERVICE_PORT=3005
AUDIT_SERVICE_INTERNAL_PORT=3005

NOTIFICATION_SERVICE_PORT=3006
NOTIFICATION_SERVICE_INTERNAL_PORT=3006

SEARCH_SERVICE_PORT=3007
SEARCH_SERVICE_INTERNAL_PORT=3007

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

NODE_ENV=development
