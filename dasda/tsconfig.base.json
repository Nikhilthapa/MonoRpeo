{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "paths": {
      "@hirenova/contracts": ["libs/shared/contracts/src/index.ts"],
      "@hirenova/events": ["libs/shared/events/src/index.ts"],
      "@hirenova/types": ["libs/shared/types/src/index.ts"],
      "@hirenova/utils": ["libs/shared/utils/src/index.ts"],
      "@hirenova/shared-types": ["libs/shared/types/src/index.ts"]
    }
  }
}
