{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build:home-web": "nx build home-web --prod",
    "build:admin-panel-web": "cross-env NODE_ENV=production nx build admin-web --prod",
    "build:all": "nx run-many --target=build --projects=home-web,admin-web --prod",
    "vercel:build:home-web": "nx build home-web --prod",
    "vercel:build:admin-panel-web": "nx build admin-web --prod",
    "serve:home-web": "cross-env PORT=3001 nx start home-web",
    "serve:admin-panel-web": "cross-env PORT=3002 nx start admin-web",
    "serve:api-gateway": "nx serve api-gateway",
    "serve:auth-service": "nx serve auth-service",
    "dev:home-web": "cross-env PORT=3003 nx dev home-web",
    "dev:admin-panel-web": "cross-env PORT=3002 nx dev admin-web",
    "prisma:generate": "./build/scripts/generate-prisma-clients.sh",
    "prisma:generate:identity": "prisma generate --schema=./prisma/schemas/identity/schema.prisma",
    "prisma:generate:tenant": "prisma generate --schema=./prisma/schemas/tenant/schema.prisma",
    "prisma:generate:organization": "prisma generate --schema=./prisma/schemas/organization/schema.prisma",
    "prisma:generate:job": "prisma generate --schema=./prisma/schemas/job/schema.prisma",
    "prisma:generate:audit": "prisma generate --schema=./prisma/schemas/audit/schema.prisma",
    "prisma:generate:workflow": "prisma generate --schema=./prisma/schemas/workflow/schema.prisma",
    "prisma:migrate": "./build/scripts/init-databases.sh",
    "prisma:migrate:identity": "prisma migrate dev --schema=./prisma/schemas/identity/schema.prisma",
    "prisma:migrate:tenant": "prisma migrate dev --schema=./prisma/schemas/tenant/schema.prisma",
    "prisma:migrate:organization": "prisma migrate dev --schema=./prisma/schemas/organization/schema.prisma",
    "prisma:migrate:job": "prisma migrate dev --schema=./prisma/schemas/job/schema.prisma",
    "prisma:migrate:audit": "prisma migrate dev --schema=./prisma/schemas/audit/schema.prisma",
    "prisma:migrate:workflow": "prisma migrate dev --schema=./prisma/schemas/workflow/schema.prisma",
    "prisma:migrate:deploy": "./build/scripts/init-databases.sh",
    "prisma:migrate:deploy:identity": "prisma migrate deploy --schema=./prisma/schemas/identity/schema.prisma",
    "prisma:migrate:deploy:tenant": "prisma migrate deploy --schema=./prisma/schemas/tenant/schema.prisma",
    "prisma:migrate:deploy:organization": "prisma migrate deploy --schema=./prisma/schemas/organization/schema.prisma",
    "prisma:migrate:deploy:job": "prisma migrate deploy --schema=./prisma/schemas/job/schema.prisma",
    "prisma:migrate:deploy:audit": "prisma migrate deploy --schema=./prisma/schemas/audit/schema.prisma",
    "prisma:migrate:deploy:workflow": "prisma migrate deploy --schema=./prisma/schemas/workflow/schema.prisma",
    "prisma:migrate:deploy:all": "npm run prisma:migrate:identity && npm run prisma:migrate:tenant && npm run prisma:migrate:organization && npm run prisma:migrate:job && npm run prisma:migrate:audit && npm run prisma:migrate:workflow",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --schema=./prisma/schemas/identity/schema.prisma",
    "prisma:studio:identity": "prisma studio --schema=./prisma/schemas/identity/schema.prisma",
    "prisma:studio:tenant": "prisma studio --schema=./prisma/schemas/tenant/schema.prisma",
    "prisma:studio:organization": "prisma studio --schema=./prisma/schemas/organization/schema.prisma",
    "prisma:studio:job": "prisma studio --schema=./prisma/schemas/job/schema.prisma",
    "prisma:studio:audit": "prisma studio --schema=./prisma/schemas/audit/schema.prisma",
    "prisma:studio:workflow": "prisma studio --schema=./prisma/schemas/workflow/schema.prisma",
    "prisma:push": "echo 'Use prisma:migrate instead for domain-based schemas'",
    "build:api-gateway": "nx build api-gateway --prod"
  },
  "private": true,
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "axios": "^1.6.0",
    "next": "~16.0.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/nest": "22.3.3",
    "@nx/next": "22.3.3",
    "@nx/node": "22.3.3",
    "@nx/playwright": "22.3.3",
    "@nx/react": "22.3.3",
    "@nx/web": "22.3.3",
    "@nx/webpack": "22.3.3",
    "@nx/workspace": "22.3.3",
    "@playwright/test": "^1.36.0",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "20.19.9",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "lucide-react": "^0.562.0",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "prisma": "^7.2.0",
    "tailwindcss": "^4.1.18",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.3.0",
    "vite-plugin-dts": "^4.5.4",
    "webpack-cli": "^5.1.4"
  }
}
