  "scripts": {
    "build:home-web": "nx build home-web --prod",
    "build:admin-panel-web": "nx build admin-panel-web --prod",
    "build:all": "nx run-many --target=build --projects=home-web,admin-panel-web --prod",
    "vercel:build:home-web": "nx build home-web --prod",
    "vercel:build:admin-panel-web": "nx build admin-panel-web --prod",
    "serve:home-web": "PORT=3001 nx start home-web",
    "serve:admin-panel-web": "PORT=3002 nx start admin-panel-web",
    "serve:api-gateway": "nx serve api-gateway",
    "dev:home-web": "PORT=3003 nx dev home-web",
    "dev:admin-panel-web": "PORT=3002 nx dev admin-panel-web",
    "prisma:generate": "prisma generate --config ./prisma.config.ts",
    "prisma:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config ./prisma.config.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio --config ./prisma.config.ts",
    "prisma:push": "prisma db push --config ./prisma.config.ts",
    "build:api-gateway": "nx build api-gateway --prod"
  },
  "private": true,
